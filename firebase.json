{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false }
  },
  "apphosting": {
    "backendId": "purelyistanbul",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "android",
      "ios",
      "latest_ipa",
      "fastlane",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
