{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false }
  },
  "apphosting": {
    "backendId": "purelyistanbul",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env*",
      ".tmp.driveupload",
      ".github",
      "android",
      "ios",
      "latest_ipa",
      "fastlane",
      "*.ipa",
      "*key*.json",
      "*.json.json",
      "temp.html",
      "temp-tab-bar.txt",
      "old_exp.json",
      "clean-dark.js",
      "fix*.js",
      "update*.js",
      "optimize-images*.js",
      "make-favicon.js",
      "rewrite_categories.js",
      "tsconfig.tsbuildinfo",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
