rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.email == 'anilaslan@usecomus.com');
    }

    function isPilotOrHotelManager() {
      return isAuthenticated() && (request.auth.token.role in ['admin', 'pilot', 'hotel_manager']);
    }

    function isGuestOwner(guestId) {
      return isAuthenticated() && request.auth.uid == guestId;
    }

    // Bir marketplace_listings durumu değişimi client (host) tarafından yapılabilir mi?
    // 'approved' durumuna GEÇİŞ sadece admin ile mümkündür (aşağıdaki host update kolunda
    // kullanılır); admin zaten isAdmin() koluyla her geçişe izinlidir.
    function isAllowedListingTransition(fromStatus, toStatus) {
      return fromStatus == toStatus ||
        (fromStatus == 'draft' && toStatus == 'pending_review') ||
        (fromStatus == 'pending_review' && toStatus == 'draft') ||
        (fromStatus == 'approved' && toStatus == 'suspended') ||
        (fromStatus == 'suspended' && toStatus == 'pending_review') ||
        (fromStatus == 'rejected' && toStatus == 'pending_review');
    }

    // 1. Listings (İlanlar)
    // Herkes aktif ilanları okuyabilir, sadece admin ve yetkili acenteler yazabilir
    match /listings/{listingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Listing Slots (Seans ve Kapasite)
    // Herkes seans uygunluğunu okuyabilir; DOĞRUDAN İSTEMCİ YAZIMLARI YASAKTIR.
    // Stok güncellemeleri yalnızca Cloud Functions (Admin SDK / runTransaction) ile yapılır.
    match /listing_slots/{slotId} {
      allow read: if true;
      allow write: if false; 
    }

    // 3. Inventory Locks (10 Dakikalık Geçici Koltuk Kilitleri)
    // İstemciler kilit oluşturamaz veya değiştiremez. Yalnızca kilit sahibi misafir veya yetkili okuyabilir.
    match /inventory_locks/{lockId} {
      allow read: if isAuthenticated() && (
        isGuestOwner(resource.data.guest_id) || 
        isPilotOrHotelManager()
      );
      allow write: if false; // Sadece Cloud Functions reserveInventorySlot & cleanup yönetir
    }

    // 4. Bookings (Kesinleşen Rezervasyonlar)
    // Misafir kendi biletini görebilir, otel konsiyerj ve pilot masası tüm biletleri denetleyebilir.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        isGuestOwner(resource.data.guest_details.guest_id) || 
        isPilotOrHotelManager()
      );
      allow write: if false; // Sadece Webhook ve Cloud Function onaylar
    }

    // 5. Fail-Safe Alert Queue
    match /system_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Purely Istanbul Marketplace (host/guest ilan pazaryeri) — yeni modül.
    // Mevcut koleksiyonlarla çakışmaması için ayrı isimlendirme kullanılır.
    // ------------------------------------------------------------------

    // 6. Kullanıcı Profilleri — herkes kendi profilini okur/yazar, admin hepsini görür.
    // roles/isAdmin/hostProfile alanları sadece admin tarafından değiştirilebilir;
    // activeRole yalnızca zaten host onayı almış kullanıcı tarafından 'host' yapılabilir.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.roles.host == resource.data.roles.host &&
        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
        (request.resource.data.activeRole == 'guest' || resource.data.roles.host == true)
      );
    }

    // 7. Host Başvuruları — kullanıcı sadece kendi 'pending' başvurusunu oluşturabilir;
    // onay/red (ve komisyon oranının belirlenmesi) sadece admin yapar.
    match /host_applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 8. Marketplace İlanları — onaylı ilanlar herkese açık; host kendi taslak/
    // incelemedeki ilanını yönetir, admin her ilanı denetler.
    match /marketplace_listings/{listingId} {
      allow read: if resource.data.status == 'approved' ||
        (isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin()));
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.status in ['draft', 'pending_review']
      );
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.hostId == request.auth.uid &&
        request.resource.data.hostId == request.auth.uid &&
        isAllowedListingTransition(resource.data.status, request.resource.data.status)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.hostId == request.auth.uid && resource.data.status == 'draft'
      );
    }

    // 9. Marketplace Rezervasyonları — misafir kendi rezervasyonunu, host kendi
    // ilanına gelen rezervasyonları görebilir. Onay/iptal admin veya ödeme
    // webhook'u (Admin SDK, kuralları by-pass eder) tarafından yapılır.
    match /marketplace_bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.guestId == request.auth.uid || resource.data.hostId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.guestId == request.auth.uid &&
        request.resource.data.status == 'pending_payment';
      allow update, delete: if isAdmin();
    }

    // 10. Ödemeler (Virtual POS'a hazır: mock/iyzico/paytr/stripe) — durum
    // güncellemeleri (pending -> completed/failed) sadece admin/ödeme sağlayıcı
    // webhook'u tarafından yapılır, doğrudan istemci yazamaz.
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.guestId == request.auth.uid || resource.data.hostId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.guestId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 11. Değerlendirmeler — herkes okuyabilir, sadece rezervasyon sahibi yazar.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.guestId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.guestId == request.auth.uid);
    }

    // 12. Favoriler — döküman id'si `${uid}_${listingId}` formatındadır.
    match /favorites/{favoriteId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // 13. Yasal Onay Kayıtları (KVKK/GDPR ispat logu) — değiştirilemez/silinemez.
    match /legal_consents/{consentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 14. CMS Medya (site içeriği görselleri) — herkes görüntüler, sadece admin yönetir.
    match /cms_media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 15. İletişim Formu Gönderimleri — herkes (giriş şart değil) mesaj bırakabilir;
    // sadece admin okur/yönetir, spam/kötüye kullanımı önlemek için alan doğrulaması yapılır.
    match /marketplace_contact_messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000;
    }

    // ------------------------------------------------------------------
    // Core Catalog & Operations Collections (firestore-service.ts & Admin Sync)
    // ------------------------------------------------------------------

    // 16. Oteller (Hotels) — herkes okuyabilir, admin ve otel yöneticisi/pilot yazabilir.
    match /hotels/{hotelId} {
      allow read: if true;
      allow create, update: if isAdmin() || isPilotOrHotelManager() || (
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 300
      );
      allow delete: if isAdmin() || isPilotOrHotelManager();
    }

    // 17. Deneyimler ve Restoranlar (Experiences) — herkes okuyabilir, sadece admin yazabilir.
    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 18. Gayrimenkul ve Yatırım Portföyü (Properties) — herkes okuyabilir, sadece admin yazabilir.
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. Tedarikçiler (Suppliers) — yetkili personel okuyabilir, sadece admin yazabilir.
    match /suppliers/{supplierId} {
      allow read: if isAdmin() || isPilotOrHotelManager();
      allow write: if isAdmin();
    }

    // 19b. Site Kategorileri (Site Categories) — herkes okuyabilir (halka açık site ve misafir uygulaması),
    // sadece admin yazabilir. Belge ID = kategori anahtarı (örn. cat-1, cat-c-1699999999).
    match /site_categories/{categoryKey} {
      function isValidSiteCategory(d) {
        return d.keys().hasOnly(['label', 'labelEn', 'order', 'hidden', 'description', 'icon', 'deleted', 'custom', 'key', 'type', 'updatedAt']) &&
          d.keys().hasAll(['label', 'order', 'hidden']) &&
          d.label is string && d.label.size() >= 1 && d.label.size() <= 80 &&
          (d.order is int || d.order is float) &&
          d.hidden is bool &&
          (!('labelEn' in d) || (d.labelEn is string && d.labelEn.size() <= 80)) &&
          (!('description' in d) || (d.description is string && d.description.size() <= 300)) &&
          (!('icon' in d) || (d.icon is string && d.icon.size() <= 200000)) &&
          (!('deleted' in d) || d.deleted is bool) &&
          (!('custom' in d) || d.custom is bool) &&
          (!('key' in d) || (d.key is string && d.key.size() <= 100)) &&
          (!('type' in d) || (d.type is string && d.type in ['experience', 'stay'])) &&
          (!('updatedAt' in d) || (d.updatedAt is string && d.updatedAt.size() <= 40));
      }

      allow read: if true;
      allow create, update: if isAdmin() && isValidSiteCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    // 20. Oda ve Konsiyerj Talepleri (Service Requests) — misafir oluşturabilir ve takip edebilir,
    // durum güncelleme ve silme işlemleri admin veya otel/pilot masası tarafından yapılır.
    match /service_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || isPilotOrHotelManager() || (
        request.resource.data.status in ['pending', 'in_progress', 'completed', 'cancelled']
      );
      allow delete: if isAdmin() || isPilotOrHotelManager() || (
        resource.data.keys().hasAny(['id', 'serviceKey', 'serviceTitle', 'status'])
      );
    }

    // 21. Yatırım Talepleri (Investment Leads) — ziyaretçiler talep bırakabilir,
    // sadece admin ve yetkili personel görüntüleyip yönetebilir.
    match /investment_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isPilotOrHotelManager();
    }

    // 22. Şikayet ve Çözüm Masası (Complaints) — herkes okuyup oluşturabilir,
    // yanıt ve durum güncellemeleri admin veya yetkili personel tarafından yapılır.
    match /complaints/{complaintId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isPilotOrHotelManager();
    }

    // 23. Admin Profilleri (Admins) — sadece admin okuyup yazabilir.
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 24. Bildirim Kuyruğu Logları (Notifications Log) — sistem/istemci log bırakabilir,
    // sadece admin ve yetkili personel okuyup yönetebilir.
    match /notifications_log/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isPilotOrHotelManager();
    }

    // 25. AI Konsiyerj Logları (AI Logs) — istemci log bırakabilir, sadece admin okuyup yönetebilir.
    match /ai_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
