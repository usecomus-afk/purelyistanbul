# Platform Mode & Legal Compliance
NEXT_PUBLIC_APP_MODE=sandbox
NEXT_PUBLIC_COMPANY_REG_NO="Purely Istanbul Ltd (Pre-registration Sandbox Staging / Company No: Pending Launch)"

# Xenios Google Cloud & Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Cockpit admin login (legacy env-var gate, checked in /api/admin-login)
ADMIN_EMAIL=anilaslan@usecomus.com
ADMIN_PASSWORD=your_admin_password_here

# Firebase Admin SDK (server-only) — bridges the cockpit admin login above to a
# real Firebase Authentication session with a `role: admin` custom claim, so
# marketplace admin actions (host approvals, listing approvals) work without a
# second sign-in. Generate in Firebase Console > Project Settings > Service
# Accounts > Generate new private key. NEVER commit the downloaded JSON —
# paste its three fields here as plain env vars instead. If left unset, the
# cockpit login still works, it just won't mint a Firebase session (the
# marketplace admin screens will then require a separate Firebase sign-in).
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# WhatsApp onayli Meta sablonlari (24 saat penceresi disi mesajlar icin ZORUNLU)
WHATSAPP_TEMPLATE_LANG=tr
WHATSAPP_TEMPLATE_ORDER_ALERT=
WHATSAPP_TEMPLATE_RESERVATION_CONFIRM=
WHATSAPP_TEMPLATE_GUEST_MESSAGE=

# Apple APNs HTTP/2 Credentials
APNS_KEY_ID=2V9KGPMLD4
APNS_TEAM_ID=R8LQC6KZG8
APNS_BUNDLE_ID=com.usecomus.olympus.R8LQC6KZG8
APNS_AUTH_KEY="your_p8_private_key_content"
APNS_USE_SANDBOX=false
